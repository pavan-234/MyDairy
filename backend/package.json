{
  "name": "mydiary-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test",
    "lint": "eslint src test",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "check": "npm test && npm run lint && npm run format:check",
    "migrate:ownership": "node src/scripts/migrateOwnership.js"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.1",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "redis": "^6.3.0",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
